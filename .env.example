# ofriperetz.dev blog — environment variables (names only; set real values in Vercel
# project env + GitHub Actions secrets). NEVER commit a real .env file.
#
# For local dev, copy to apps/web/.env.local (Next.js) and/or .env at repo root
# (the publish-to-devto script reads via dotenv from the repo root).

# --- Public site ---
NEXT_PUBLIC_SITE_URL=https://ofriperetz.dev

# --- Scorecard backend: Supabase North-Star ratchet (READ-ONLY via anon key; RLS must be ON) ---
SUPABASE_URL=
SUPABASE_ANON_KEY=

# --- Live stats (server-side API routes only) ---
GITHUB_TOKEN=
DEVTO_API_KEY=

# --- ISR cache revalidation (server-side) ---
REVALIDATE_SECRET=
