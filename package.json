{
  "name": "ofri-peretz-blog",
  "private": true,
  "version": "0.0.0",
  "description": "ofriperetz.dev — blog + scorecard. A shadcn Next.js app powered by the Interlace design-system registry.",
  "license": "MIT",
  "workspaces": [
    "apps/*"
  ],
  "packageManager": "npm@11.6.2",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "format": "prettier --check \"**/*.{md,mdx,ts,tsx,js,mjs,json,yml,yaml}\"",
    "format:write": "prettier --write \"**/*.{md,mdx,ts,tsx,js,mjs,json,yml,yaml}\"",
    "publish:devto": "node apps/blog/scripts/publish-to-devto.mjs",
    "publish:devto:dry": "node apps/blog/scripts/publish-to-devto.mjs --dry-run",
    "sdlc:verify": "node scripts/sdlc/detect-stale-claims.mjs",
    "sdlc:links": "node scripts/sdlc/check-links.mjs",
    "sdlc:reception": "node scripts/sdlc/reception-band.mjs",
    "sdlc:detect": "node scripts/sdlc/detect.mjs",
    "sdlc:new": "node scripts/sdlc/new.mjs"
  },
  "devDependencies": {
    "prettier": "^3.5.3",
    "turbo": "^2.5.0"
  },
  "allowScripts": {
    "oxc-resolver@11.24.2": true,
    "esbuild@0.28.2": true
  }
}
